<?xml version="1.0" encoding="utf-8"?>
<!-- Trusts the system CAs and the ones installed on the phone, so a server behind a private CA
     works once its CA is installed in Android's settings. No CA ships in the app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
