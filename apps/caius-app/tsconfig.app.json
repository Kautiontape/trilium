{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [ "ES2023", "DOM", "DOM.Iterable" ],
    "outDir": "out-tsc/app",
    "types": [ "vite/client" ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "../../packages/caius/tsconfig.lib.json"
    },
    {
      "path": "../../packages/commons/tsconfig.lib.json"
    }
  ]
}
